rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write to their own user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Users can manage their own voice commands and related data.
      match /voiceCommands/{voiceCommandId}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Users can manage their own learned commands.
      match /learnedCommands/{learnedCommandId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
