rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write to their own data tree.
    // This allows access to the user document and all sub-collections
    // (voiceCommands, codeModifications, aiResponses, sensoryMemory, etc.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allData=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}