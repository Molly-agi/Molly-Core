/**
 * Core Philosophy: This ruleset enforces a strict user-ownership security model. All data is siloed within a
 * user-specific data tree, ensuring that a user can only ever access their own information. There is no
 * public or shared data.
 *
 * Data Structure: The entire data model is hierarchical, rooted at `/users/{userId}`. All other collections,
 * such as `voiceCommands` and their related sub-collections (e.g., `commandExecutions`, `installations`), are
 * nested under this user-specific path. This structure makes ownership explicit and rules simple.
 *
 * Key Security Decisions:
 * - User Isolation: A user's authentication UID (`request.auth.uid`) is used to grant access only to documents
 *   within their corresponding path (`/users/{request.auth.uid}/...`).
 * - No Public Listing: Listing the top-level `/users` collection is explicitly forbidden to prevent user enumeration.
 * - Ownership by Path: Authorization for nested documents relies on the `{userId}` wildcard in the path, which is
 *   the most performant and secure method for this data structure.
 * - Relational Integrity: On creation, documents must contain the correct owner ID to link them to their parent
 *   user document, and this link is immutable. For deeply nested documents, the existence of the parent document
 *   is verified before creation is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------------------

    /**
     * isSignedIn
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * isOwner
     * Validates that the requesting user's UID matches the document's owner ID from the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * isExistingOwner
     * A stricter version of isOwner used for update/delete operations.
     * Ensures the document exists before attempting to modify it.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * isValidUserCreate
     * Ensures the new user document contains its own ID for data consistency.
     */
    function isValidUserCreate(userId) {
      return request.resource.data.id == userId;
    }
    
    /**
     * isImmutableUserId
     * Ensures the user ID within a user document cannot be changed after creation.
     */
    function isImmutableUserId() {
      return request.resource.data.id == resource.data.id;
    }
    
    /**
     * isValidVoiceCommandCreate
     * Ensures a new voice command document is correctly linked to its owner via an internal 'userId' field.
     */
    function isValidVoiceCommandCreate(userId) {
      return request.resource.data.userId == userId;
    }
    
    /**
     * isImmutableVoiceCommandUserId
     * Ensures the ownership link ('userId' field) on a voice command cannot be changed after creation.
     */
    function isImmutableVoiceCommandUserId() {
      return request.resource.data.userId == resource.data.userId;
    }
    
    /**
     * parentVoiceCommandExists
     * Verifies that the parent voiceCommand document exists before allowing a child document to be created.
     * This maintains relational integrity in the nested structure.
     */
    function parentVoiceCommandExists(userId, voiceCommandId) {
      return exists(/databases/$(database)/documents/users/$(userId)/voiceCommands/$(voiceCommandId));
    }


    // --------------------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow (create) A new user can create their own profile document if their auth UID matches the document ID.
     * @deny (get) An authenticated user cannot read another user's profile.
     * @principle Restricts access to a user's own data tree and enforces self-creation of the root document.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow listing all users to prevent enumeration attacks.
      allow create: if isOwner(userId) && isValidUserCreate(userId);
      allow update: if isExistingOwner(userId) && isImmutableUserId();
      allow delete: if isExistingOwner(userId);

      /**
       * @description Stores voice commands initiated by a user.
       * @path /users/{userId}/voiceCommands/{voiceCommandId}
       * @allow (create) An authenticated user can create a voice command document under their own profile.
       * @deny (list) An authenticated user cannot list voice commands belonging to another user.
       * @principle Enforces strict ownership. All actions on a voice command are restricted to the owner.
       */
      match /voiceCommands/{voiceCommandId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVoiceCommandCreate(userId);
        allow update: if isExistingOwner(userId) && isImmutableVoiceCommandUserId();
        allow delete: if isExistingOwner(userId);

        /**
         * @description Stores command execution details related to a voice command.
         * @path /users/{userId}/voiceCommands/{voiceCommandId}/commandExecutions/{commandExecutionId}
         * @allow (get, list, create, update, delete) The user who owns the parent voice command.
         * @deny (any) Any user who does not own the parent voice command.
         * @principle Inherits ownership from the parent user path.
         */
        match /commandExecutions/{commandExecutionId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && parentVoiceCommandExists(userId, voiceCommandId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }

        /**
         * @description Stores installation details related to a voice command.
         * @path /users/{userId}/voiceCommands/{voiceCommandId}/installations/{installationId}
         * @allow (get, list, create, update, delete) The user who owns the parent voice command.
         * @deny (any) Any user who does not own the parent voice command.
         * @principle Inherits ownership from the parent user path.
         */
        match /installations/{installationId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && parentVoiceCommandExists(userId, voiceCommandId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }

        /**
         * @description Stores code modification details related to a voice command.
         * @path /users/{userId}/voiceCommands/{voiceCommandId}/codeModifications/{codeModificationId}
         * @allow (get, list, create, update, delete) The user who owns the parent voice command.
         * @deny (any) Any user who does not own the parent voice command.
         * @principle Inherits ownership from the parent user path.
         */
        match /codeModifications/{codeModificationId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && parentVoiceCommandExists(userId, voiceCommandId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }

        /**
         * @description Stores GitHub repository details related to a voice command.
         * @path /users/{userId}/voiceCommands/{voiceCommandId}/gitHubRepos/{gitHubRepoId}
         * @allow (get, list, create, update, delete) The user who owns the parent voice command.
         * @deny (any) Any user who does not own the parent voice command.
         * @principle Inherits ownership from the parent user path.
         */
        match /gitHubRepos/{gitHubRepoId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && parentVoiceCommandExists(userId, voiceCommandId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }

        /**
         * @description Stores root access requests related to a voice command.
         * @path /users/{userId}/voiceCommands/{voiceCommandId}/rootAccessRequests/{rootAccessRequestId}
         * @allow (get, list, create, update, delete) The user who owns the parent voice command.
         * @deny (any) Any user who does not own the parent voice command.
         * @principle Inherits ownership from the parent user path.
         */
        match /rootAccessRequests/{rootAccessRequestId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && parentVoiceCommandExists(userId, voiceCommandId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }

        /**
         * @description Stores AI responses related to a voice command.
         * @path /users/{userId}/voiceCommands/{voiceCommandId}/aiResponses/{aiResponseId}
         * @allow (get, list, create, update, delete) The user who owns the parent voice command.
         * @deny (any) Any user who does not own the parent voice command.
         * @principle Inherits ownership from the parent user path.
         */
        match /aiResponses/{aiResponseId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && parentVoiceCommandExists(userId, voiceCommandId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }

        /**
         * @description Stores error logs related to a voice command.
         * @path /users/{userId}/voiceCommands/{voiceCommandId}/errorLogs/{errorLogId}
         * @allow (get, list, create, update, delete) The user who owns the parent voice command.
         * @deny (any) Any user who does not own the parent voice command.
         * @principle Inherits ownership from the parent user path.
         */
        match /errorLogs/{errorLogId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && parentVoiceCommandExists(userId, voiceCommandId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }
      }
    }
  }
}