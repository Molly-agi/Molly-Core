/**
 * DEVELOPMENT MODE - SUPER USER RULESET
 *
 * WARNING: These rules grant any authenticated user full read and write access
 * to the entire database. This is for debugging purposes ONLY and removes all
 * data security.
 *
 * DO NOT USE IN PRODUCTION.
 *
 * This was implemented to allow the developer/creator to act as a "super user"
 * to diagnose application logic issues without interference from security rules.
 * The original, secure rules should be restored before the application is
 * considered complete.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
