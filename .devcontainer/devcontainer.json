{
  "name": "Molly-Core Cloud Womb",

  // Run health check on every attach/reconnect to kill zombie processes
  // before they accumulate and cause OOM crashes.
  // Save session state so Copilot can restore context after reconnect.
  // Start keep-alive heartbeat to prevent idle timeout (critical for mobile).
  "postAttachCommand": "bash scripts/codespace-health.sh && node scripts/save-session.mjs --status active --note 'Codespace reconnected' && nohup bash scripts/keep-alive.sh > /dev/null 2>&1 &",

  // Codespace settings + grant gh CLI permission to manage Actions runs
  "customizations": {
    "codespaces": {
      "permissions": {
        "actions": "write"
      }
    },
    "vscode": {
      "settings": {
        // Inherit from .vscode/settings.json
      }
    }
  },

  // Forward Molly's port
  "forwardPorts": [9002],
  "portsAttributes": {
    "9002": {
      "label": "Molly Dev Server",
      "onAutoForward": "notify"
    }
  }
}
