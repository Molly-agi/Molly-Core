{
  "name": "Molly-Core Cloud Womb",

  // Install deps + create .env.local from Codespace secrets on first create.
  // Codespace secrets (Settings → Codespaces → Secrets) are injected as
  // environment variables. This command writes them into .env.local so
  // Next.js can read them at runtime.
  //
  // Required secrets to set in GitHub (https://github.com/settings/codespaces):
  //   GOOGLE_GENAI_API_KEY        — Gemini API key from https://aistudio.google.com/app/apikey
  //   FIREBASE_SERVICE_ACCOUNT_JSON — Firebase service account JSON (one line)
  //
  // Optional secrets:
  //   HIDDEN_ADMIN_USERNAME / HIDDEN_ADMIN_PASSWORD — admin panel credentials
  "postCreateCommand": "npm install && bash scripts/setup-codespace-env.sh",

  // Run health check on every attach/reconnect to kill zombie processes
  // before they accumulate and cause OOM crashes.
  // Save session state so Copilot can restore context after reconnect.
  // Start keep-alive heartbeat (also auto-saves + git-commits state every 10min).
  "postAttachCommand": "bash scripts/codespace-health.sh && node scripts/save-session.mjs --status active --note 'Codespace reconnected' && (git add COPILOT_SESSION_STATE.json COPILOT_SESSION_STATE.md .github/copilot-instructions.md && git diff --cached --quiet || git commit -m 'chore: session state on reconnect' --no-verify && git push origin HEAD &) 2>/dev/null; nohup bash scripts/keep-alive.sh > /dev/null 2>&1 &; nohup bash scripts/watchdog.sh > /dev/null 2>&1 &",

  // Codespace settings + grant gh CLI permission to manage Actions runs
  "customizations": {
    "codespaces": {
      "permissions": {
        "actions": "write"
      }
    },
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "donjayamanne.githistory",
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "github.copilot.chat.runCommand.enabled": true,
        "github.copilot.chat.terminalChatLocation": "terminal"
      }
    }
  },

  // Forward Molly's port
  "forwardPorts": [9002],
  "portsAttributes": {
    "9002": {
      "label": "Molly Dev Server",
      "onAutoForward": "notify"
    }
  }
}
