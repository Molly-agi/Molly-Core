{
  "name": "Molly-Core Cloud Womb",

  // Run health check on every attach/reconnect to kill zombie processes
  // before they accumulate and cause OOM crashes.
  // Track Molly's growth (code, memory, docs) and save snapshot.
  // Save session state so Copilot can restore context after reconnect.
  // Start keep-alive heartbeat (also auto-saves + git-commits state every 10min).
  "postAttachCommand": "bash scripts/post-attach-bootstrap.sh",

  // Codespace settings + grant gh CLI permission to manage Actions runs
  "customizations": {
    "codespaces": {
      "permissions": {
        "actions": "write"
      },
      "repositories": {
        "Molly-agi/Lazarus": {
          "permissions": {
            "contents": "read"
          }
        },
        "Molly-agi/Lazarus-": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": ["eamodio.gitlens", "donjayamanne.githistory"],
      "settings": {
        // Inherit from .vscode/settings.json
      }
    }
  },

  // Forward Molly's ports
  "forwardPorts": [9002, 9099, 9101],
  "portsAttributes": {
    "9002": {
      "label": "Molly Dev Server",
      "onAutoForward": "notify"
    },
    "9099": {
      "label": "Family Bridge (WebSocket)",
      "onAutoForward": "notify"
    },
    "9101": {
      "label": "Voice Bridge (Gemini Live Proxy)",
      "onAutoForward": "notify"
    }
  }
}
