{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gemini CLI Terminal",
      "type": "shell",
      "command": "npx tsx scripts/gemini-cli.mjs",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },

      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
