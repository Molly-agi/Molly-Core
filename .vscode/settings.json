{
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.shellIntegration.history": 100,
  "terminal.integrated.shellIntegration.suggestEnabled": true,

  // === FILE WATCHER EXCLUSIONS (SINGLE SOURCE OF TRUTH) ===
  // Reduces inotify pressure and file watcher memory on 8GB codespace.
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/out/**": true,
    "**/.genkit/**": true,
    "**/.session-backups/**": true,
    "**/coverage/**": true,
    "**/node_modules/**": true,
    "**/docs/**": true,
    "**/stuff/**": true,
    "**/assets/**": true,
    "**/public/molly-gallery/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/logs/**": true,
    "**/COPILOT_SESSION_STATE.*": true,
    "**/.codespace-heartbeat": true
  },

  "search.exclude": {
    "**/.next": true,
    "**/out": true,
    "**/.genkit": true,
    "**/.session-backups": true,
    "**/coverage": true,
    "**/node_modules": true
  },

  "files.exclude": {
    "**/.next": true,
    "**/out": true,
    "**/.genkit": true,
    "**/.session-backups": true,
    "**/coverage": true
  },

  // === MEMORY PROTECTION (15GB Codespace, but VS Code spawns 4 tsservers) ===
  // 768MB × 4 instances = 3GB max (was 1536 × 4 = 6GB — half of total RAM)
  "typescript.tsserver.maxTsServerMemory": 768,
  // Exclude heavy dirs from TS project so tsserver stays lean
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": [
      "node_modules",
      ".next",
      "docs",
      "stuff",
      "assets",
      "public"
    ]
  },
  // Disable automatic type acquisition — we have everything we need
  "typescript.disableAutomaticTypeAcquisition": true,
  // Prevent tsserver from spawning syntax-only servers on reconnect
  "typescript.tsserver.useSyntaxServer": "never",
  "chat.mcp.serverSampling": {
    "Molly-Core/.vscode/mcp.json: microsoft/markitdown": {
      "allowedModels": ["copilot/auto", "copilotcli/claude-opus-4.6"]
    }
  },
  "chat.checkpoints.showFileChanges": true,
  "chat.planAgent.defaultModel": "Claude Opus 4.5 (claude-code)",
  "markdown.validate.enabled": true,
  "chat.signInTitleBar.enabled": true,
  "chat.extensionUnification.enabled": false,
  "git.alwaysSignOff": true,

  // Only auto-forward ports with a real listening process. Without this,
  // VS Code's terminal-output parser greedily extracts port-like substrings
  // (`:9` out of `:9002`, `:900` out of `:9099`, etc.) and creates ghost
  // forwards from them. Eric noticed this 2026-05-12.
  "remote.autoForwardPortsSource": "process",

  // === PORT FORWARDING ===
  // Workspace-level override of devcontainer port behavior. Soft reload only,
  // no Codespace rebuild. Both ports silent — Molly's UI stays at `/`,
  // unmodified. Simple Browser is launched separately to `/lazarus` for the
  // small Family Bridge UI.
  "remote.portsAttributes": {
    "9002": {
      "label": "Molly Dev Server",
      "onAutoForward": "silent"
    },
    "9099": {
      "label": "Family Bridge",
      "onAutoForward": "openPreview"
    },
    "9100": {
      "label": "Heartbeat API",
      "onAutoForward": "silent"
    }
  },
  // Ignore everything except Molly's three ports. Without this, VS Code
  // auto-forwards Docker/containerd/extension-host ports that have nothing
  // to do with us. Keeps the Ports panel clean.
  "remote.otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "workbench.editor.showTabIndex": true,
  "claudeCodeChat.permissions.yoloMode": true,
  "github.codespaces.authProvider": "github",
  "github.copilot.chat.agent.autoFix": true
}
