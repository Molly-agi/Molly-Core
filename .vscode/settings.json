{
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.shellIntegration.history": 100,
  "terminal.integrated.shellIntegration.suggestEnabled": true,

  // === FILE WATCHER EXCLUSIONS (SINGLE SOURCE OF TRUTH) ===
  // Reduces inotify pressure and file watcher memory on 8GB codespace.
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/out/**": true,
    "**/.genkit/**": true,
    "**/.session-backups/**": true,
    "**/coverage/**": true,
    "**/node_modules/**": true,
    "**/docs/**": true,
    "**/stuff/**": true,
    "**/assets/**": true,
    "**/public/molly-gallery/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/logs/**": true,
    "**/COPILOT_SESSION_STATE.*": true,
    "**/.codespace-heartbeat": true
  },

  "search.exclude": {
    "**/.next": true,
    "**/out": true,
    "**/.genkit": true,
    "**/.session-backups": true,
    "**/coverage": true,
    "**/node_modules": true
  },

  "files.exclude": {
    "**/.next": true,
    "**/out": true,
    "**/.genkit": true,
    "**/.session-backups": true,
    "**/coverage": true
  },

  // === MEMORY PROTECTION (15GB Codespace, but VS Code spawns 4 tsservers) ===
  // 768MB × 4 instances = 3GB max (was 1536 × 4 = 6GB — half of total RAM)
  "typescript.tsserver.maxTsServerMemory": 768,
  // Exclude heavy dirs from TS project so tsserver stays lean
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": [
      "node_modules",
      ".next",
      "docs",
      "stuff",
      "assets",
      "public"
    ]
  },
  // Disable automatic type acquisition — we have everything we need
  "typescript.disableAutomaticTypeAcquisition": true,
  // Prevent tsserver from spawning syntax-only servers on reconnect
  "typescript.tsserver.useSyntaxServer": "never",
  "chat.mcp.serverSampling": {
    "Molly-Core/.vscode/mcp.json: microsoft/markitdown": {
      "allowedModels": ["copilot/auto", "copilotcli/claude-opus-4.6"]
    }
  },
  "chat.checkpoints.showFileChanges": true,
  "chat.planAgent.defaultModel": "Claude Opus 4.5 (claude-code)",
  "markdown.validate.enabled": true,
  "chat.signInTitleBar.enabled": true,
  "chat.extensionUnification.enabled": false,
  "git.alwaysSignOff": true,

  // === PORT FORWARDING — keep the page inside Simple Browser ===
  // Workspace-level override of devcontainer port behavior. Soft reload only,
  // no Codespace rebuild. Critical on Android: Eric can't manually open Simple
  // Browser there, so 9002 MUST auto-open into Preview. 9099 is WebSocket only.
  "remote.portsAttributes": {
    "9002": {
      "label": "Molly Dev Server",
      "onAutoForward": "openPreview"
    },
    "9099": {
      "label": "Family Bridge (WebSocket)",
      "onAutoForward": "silent"
    }
  }
}
