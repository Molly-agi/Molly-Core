    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/out": true,
    "**/.genkit": true,
    "**/.session-backups": true,
    "**/coverage": true,
    "**/node_modules": true
  },
  "files.exclude": {
    "**/.next": true,
    "**/out": true,
    "**/.genkit": true,
    "**/.session-backups": true,
    "**/coverage": true
  }
}
