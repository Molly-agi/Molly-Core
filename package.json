{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev -H 0.0.0.0 -p 9002",
    "dev:turbo": "NODE_OPTIONS=--max-old-space-size=4096 next dev --turbo -p 9002",
    "dev:fresh": "npm run harden && NODE_OPTIONS=--max-old-space-size=4096 next dev -p 9002",
    "debug": "NODE_OPTIONS='--inspect' next dev -p 9002",
    "harden": "rm -rf .next",
    "monitor": "node scripts/molly-monitor.mjs",
    "monitor:watch": "node scripts/molly-monitor.mjs --continuous",
    "codespace:reset": "bash scripts/codespace-reset.sh",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "npm run harden && NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "1.22.0",
    "@genkit-ai/next": "1.22.0",
    "@hookform/resolvers": "4.1.3",
    "@octokit/rest": "21.0.0",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.11",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toast": "1.2.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "cheerio": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "dotenv": "16.5.0",
    "embla-carousel-react": "8.6.0",
    "file-saver": "2.0.5",
    "firebase": "10.13.1",
    "firebase-admin": "12.3.1",
    "genkit": "1.22.0",
    "lucide-react": "0.475.0",
    "next": "15.1.11",
    "react": "19.0.0",
    "react-day-picker": "8.10.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.1",
    "tailwind-merge": "3.0.1",
    "tailwindcss-animate": "1.0.7",
    "tesseract.js": "5.1.1",
    "wav": "1.0.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/file-saver": "2.0.7",
    "@types/jest": "29.5.3",
    "@types/node": "22.10.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "eslint": "8.57.0",
    "eslint-config-next": "15.1.11",
    "eslint-config-prettier": "10.0.1",
    "genkit-cli": "1.22.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "15.4.3",
    "postcss": "8.4.0",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.1",
    "typescript": "5.7.3"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
