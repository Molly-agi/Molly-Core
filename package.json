{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/codespace-health.sh --predev && node scripts/save-session.mjs --status active",
    "dev": "NODE_OPTIONS=--max-old-space-size=3072 next dev -H 0.0.0.0 -p 9002",
    "dev:turbo": "NODE_OPTIONS=--max-old-space-size=3072 next dev --turbo -p 9002",
    "dev:fresh": "npm run harden && NODE_OPTIONS=--max-old-space-size=3072 next dev -p 9002",
    "dev:unsafe": "NODE_OPTIONS=--max-old-space-size=4096 next dev -H 0.0.0.0 -p 9002",
    "debug": "NODE_OPTIONS='--inspect' next dev -p 9002",
    "harden": "rm -rf .next",
    "monitor": "node scripts/molly-monitor.mjs",
    "monitor:watch": "node scripts/molly-monitor.mjs --continuous",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "npm run harden && NODE_OPTIONS=--max-old-space-size=12288 NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 20",
    "typecheck": "echo '⚠️  Standalone tsc OOMs on this project (needs >8GB). Use: npm run typecheck:build' && exit 1",
    "typecheck:build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "health": "bash scripts/codespace-health.sh",
    "health:watch": "bash scripts/codespace-health.sh --watch",
    "keep-alive": "nohup bash scripts/keep-alive.sh > /dev/null 2>&1 &",
    "watchdog": "nohup bash scripts/watchdog.sh > /dev/null 2>&1 &",
    "bridge": "node scripts/bridge-daemon.mjs",
    "bridge:listen": "node scripts/bridge-listen.mjs",
    "save-session": "node scripts/save-session.mjs",
    "save-session:pause": "node scripts/save-session.mjs --status paused"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@genkit-ai/google-genai": "^1.30.1",
    "@genkit-ai/next": "^1.30.1",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "8.6.0",
    "file-saver": "2.0.5",
    "firebase": "^12.11.0",
    "firebase-admin": "^10.3.0",
    "genkit": "^1.30.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "recharts": "2.15.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "1.0.7",
    "tesseract.js": "5.1.1",
    "wav": "1.0.2",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "genkit-cli": "^0.0.2",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "3.4.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
