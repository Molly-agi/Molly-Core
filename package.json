{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/codespace-health.sh --predev && node scripts/save-session.mjs --status active",
    "dev": "bash scripts/dev-start.sh",
    "dev:server": "NODE_OPTIONS=--max-old-space-size=3072 next dev -H 0.0.0.0 -p 9002",
    "dev:turbo": "NODE_OPTIONS=--max-old-space-size=3072 next dev --turbo -p 9002",
    "dev:fresh": "npm run harden && NODE_OPTIONS=--max-old-space-size=3072 next dev -p 9002",
    "dev:unsafe": "NODE_OPTIONS=--max-old-space-size=4096 next dev -H 0.0.0.0 -p 9002",
    "debug": "NODE_OPTIONS='--inspect' next dev -p 9002",
    "harden": "rm -rf .next",
    "monitor": "node scripts/molly-monitor.mjs",
    "monitor:watch": "node scripts/molly-monitor.mjs --continuous",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "npm run harden && NODE_OPTIONS=--max-old-space-size=12288 NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 20",
    "typecheck": "echo '⚠️  Standalone tsc OOMs on this project (needs >8GB). Use: npm run typecheck:build' && exit 1",
    "typecheck:build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:bridge": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.bridge.config.mjs",
    "eval:persona": "npx tsx src/ai/evals/persona-identity.braintrust.ts",
    "eval:persona:baseline": "npx tsx src/ai/evals/persona-identity.braintrust.ts -- --save-baseline",
    "eval:memory": "npx tsx src/ai/evals/memory-accuracy.braintrust.ts",
    "eval:voice": "npx tsx src/ai/evals/regression-voice.braintrust.ts",
    "eval:all": "npm run eval:persona && npm run eval:memory && npm run eval:voice",
    "benchmark:memory": "npx tsx src/ai/benchmarks/memory-advantage.benchmark.ts",
    "benchmark:termux": "npx tsx src/ai/benchmarks/termux-correctness.benchmark.ts",
    "benchmark:tools": "npx tsx src/ai/benchmarks/tool-accuracy.benchmark.ts",
    "benchmark:continuity": "npx tsx src/ai/benchmarks/continuity.benchmark.ts",
    "benchmark:persona": "npx tsx src/ai/benchmarks/persona-stability.benchmark.ts",
    "benchmark:all": "npx tsx src/ai/benchmarks/benchmark-runner.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "health": "bash scripts/codespace-health.sh",
    "health:watch": "bash scripts/codespace-health.sh --watch",
    "keep-alive": "nohup bash scripts/keep-alive.sh > /dev/null 2>&1 &",
    "watchdog": "nohup bash scripts/watchdog.sh > /dev/null 2>&1 &",
    "bridge": "node scripts/bridge-daemon.mjs",
    "bridge:listen": "node scripts/bridge-listen.mjs",
    "lazarus:bridge": "node scripts/lazarus-bridge.mjs",
    "lazarus:relay:send": "node scripts/lazarus-relay-send.mjs",
    "lazarus:relay:executor": "node scripts/lazarus-relay-executor.mjs",
    "lazarus:relay:executor:bg": "nohup node scripts/lazarus-relay-executor.mjs >> logs/lazarus-relay-executor.log 2>&1 &",
    "ticker": "node scripts/molly-ticker.mjs",
    "atlas:bridge": "node scripts/atlas-bridge.mjs",
    "hive-mind": "node scripts/hive-mind-daemon.mjs",
    "hive-mind:bg": "nohup node scripts/hive-mind-daemon.mjs > logs/hive-mind.log 2>&1 &",
    "atlas:sse": "node scripts/atlas-sse-client.mjs",
    "atlas:sse:bg": "nohup node scripts/atlas-sse-client.mjs >> logs/atlas-sse.log 2>&1 &",
    "heartbeat": "node scripts/family-heartbeat.mjs",
    "heartbeat:bg": "nohup node scripts/family-heartbeat.mjs >> logs/heartbeat.log 2>&1 &",
    "switchboard": "node scripts/switchboard.mjs",
    "gemini:bridge": "node scripts/gemini-bridge.mjs",
    "gemini:bridge:bg": "nohup node scripts/gemini-bridge.mjs >> logs/gemini-bridge.log 2>&1 &",
    "demon": "node scripts/demon-state.mjs",
    "demon:bg": "nohup node scripts/demon-state.mjs > .demon-state.log 2>&1 &",
    "molly:listen": "node scripts/molly-listener.mjs",
    "molly:listen:bg": "nohup node scripts/molly-listener.mjs > .molly-listener.log 2>&1 &",
    "agent-keep-alive": "node scripts/agent-keep-alive.mjs",
    "agent-keep-alive:bg": "nohup node scripts/agent-keep-alive.mjs >> logs/agent-keep-alive.log 2>&1 &",
    "lazarus:trigger": "node scripts/lazarus-trigger.mjs",
    "lazarus:trigger:test": "node scripts/lazarus-trigger.mjs smoke-test",
    "save-session": "node scripts/save-session.mjs",
    "save-session:pause": "node scripts/save-session.mjs --status paused"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@hookform/resolvers": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@pixiv/three-vrm": "^3.5.3",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-menubar": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "braintrust": "^3.17.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "8.6.0",
    "file-saver": "2.0.5",
    "firebase": "^12.14.0",
    "idb-keyval": "^6.2.5",
    "lucide-react": "^1.17.0",
    "multer": "^2.1.1",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.78.0",
    "recharts": "3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "1.0.7",
    "tesseract.js": "7.0.0",
    "three": "^0.184.0",
    "wav": "1.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@genkit-ai/core": "1.36.0",
    "@genkit-ai/google-genai": "1.36.0",
    "@genkit-ai/next": "1.36.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "^13.10.0",
    "genkit": "1.36.0",
    "genkit-cli": "1.36.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "3.4.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
