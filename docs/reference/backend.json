{
  "entities": {
    "VoiceCommand": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "VoiceCommand",
      "type": "object",
      "description": "Represents a voice command received from the user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "commandText": { "type": "string" },
        "interpretedText": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "commandText",
        "interpretedText",
        "timestamp"
      ]
    },
    "APIBlueprint": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "APIBlueprint",
      "type": "object",
      "description": "A synthetic or cloned API specification stored in Molly's Neural Vault.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["Normal", "Administrator", "SuperUser"]
        },
        "description": { "type": "string" },
        "targetUrl": { "type": "string", "format": "uri" },
        "syntheticImplementation": { "type": "string" },
        "vibeAnchor": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "syntheticImplementation", "timestamp"]
    },
    "CommandExecution": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CommandExecution",
      "type": "object",
      "description": "Represents the execution of a command in Termux.",
      "properties": {
        "id": { "type": "string" },
        "voiceCommandId": { "type": "string" },
        "command": { "type": "string" },
        "executionStatus": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "output": { "type": "string" }
      },
      "required": [
        "id",
        "voiceCommandId",
        "command",
        "executionStatus",
        "startTime",
        "endTime",
        "output"
      ]
    },
    "Installation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Installation",
      "type": "object",
      "description": "Represents an installation managed by the tool.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "status", "startTime", "endTime"]
    },
    "CodeModification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CodeModification",
      "type": "object",
      "description": "Represents a code modification.",
      "properties": {
        "id": { "type": "string" },
        "filePath": { "type": "string" },
        "modifiedCode": { "type": "string" },
        "modificationSuggestion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "filePath",
        "modifiedCode",
        "modificationSuggestion",
        "timestamp"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "registrationDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "email", "registrationDate"]
    },
    "AIResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AIResponse",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "responseText": { "type": "string" },
        "responseType": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "responseText", "responseType", "timestamp"]
    },
    "LearnedCommand": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LearnedCommand",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "command": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "prompt", "command", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles."
    },
    "/users/{userId}/apiBlueprints/{blueprintId}": {
      "schema": { "$ref": "#/backend/entities/APIBlueprint" },
      "description": "Molly's vault of synthetic and cloned API patterns."
    },
    "/users/{userId}/codeModifications/{modId}": {
      "schema": { "$ref": "#/backend/entities/CodeModification" },
      "description": "Code modifications."
    },
    "/users/{userId}/aiResponses/{responseId}": {
      "schema": { "$ref": "#/backend/entities/AIResponse" },
      "description": "AI responses."
    },
    "/users/{userId}/learnedCommands/{commandId}": {
      "schema": { "$ref": "#/backend/entities/LearnedCommand" },
      "description": "Learned commands."
    }
  }
}
