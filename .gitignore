# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Environment variables
.env
.env.*
!.env.example
.local
.development.local
.test.local
.production.local

# Firebase
*.firebase.json
firebase-debug.log
firestore-debug.log
*-firebase-adminsdk-*.json

# Local sensitive files
/stuff/

# Session backups (main session state files ARE tracked for recovery)
.session-backups/
.codespace-heartbeat
.watchdog.pid
.watchdog-pulse
.watchdog.log

# Genkit runtime artifacts
.genkit/runtimes/
.genkit/servers/

# Gallery image processing
/public/molly-gallery/portraits-backup/
/public/molly-gallery/portraits-clean/molly_sentinel/
eng.traineddata
.molly-logs/
.molly/

# Shrouded Memory — sensitive identity data, never commit with real values
molly_sentinel/identity_manifest.json
__pycache__/
*.pyc
src/ai/bridge/conversation.json
.tsbuildinfo

# Sandbox — Molly's coding workspace (runtime files, not code artifacts)
sandbox/molly-workspace/*
!sandbox/molly-workspace/.gitkeep

# Bridge daemon runtime files
.bridge-daemon.log
.bridge-daemon.pid

# Local storage data (test artifacts / runtime state)
molly_data/

# Playwright
test-results/
playwright-report/
playwright/.cache/
