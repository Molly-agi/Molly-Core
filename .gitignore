# Local bridge auth secrets (per-device). Keep out of git.
scripts/bridge-secrets.json
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Environment variables
.env
.env.*
!.env.example
.local
.development.local
.test.local
.production.local

# Firebase
*.firebase.json
firebase-debug.log
firestore-debug.log
*-firebase-adminsdk-*.json

# Session backups (main session state files ARE tracked for recovery)
.session-backups/
.session-events.jsonl
.anthropic-traffic/
.codespace-heartbeat
.watchdog.pid
.watchdog-pulse
.watchdog.log

# Genkit runtime artifacts
.genkit/runtimes/
.genkit/servers/

# Gallery image processing
/public/molly-gallery/portraits-backup/
/public/molly-gallery/portraits-clean/molly_sentinel/
eng.traineddata
.molly-logs/
.molly/
# Allow Molly's personality state to be committed so changes persist across
# codespace rebuilds and clones. The file is just slider values 0..1, not
# secrets, and losing it silently was a major part of the "admin panel
# doesn't lock in changes" bug (Eric directive 2026-06-15).
!.molly/
.molly/*
!.molly/personality-state.json

# Shrouded Memory — sensitive identity data, never commit with real values
molly_sentinel/identity_manifest.json
__pycache__/
*.pyc
src/ai/bridge/conversation.json
.tsbuildinfo

# Sandbox — Molly's coding workspace (runtime files, not code artifacts)
sandbox/molly-workspace/*
!sandbox/molly-workspace/.gitkeep

# Bridge daemon runtime files
.bridge-daemon.log
.bridge-daemon.pid

# Local storage data (test artifacts / runtime state)
molly_data/

# Triple-bind mirror — Molly's "don't panic" leg 3 (item 21)
# Lives under tracked stuff/ folder but writes are gitignored so memory writes
# do not pollute git history. Sync to phone out-of-band (Syncthing, rsync, etc.)
stuff/dont-panic/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Android build artifacts
android/MollyBrowser/.gradle/
android/MollyBrowser/app/build/
android/MollyBrowser/build/
*.gradle/
**/build/

# Immortal session daemon
.immortal.log
.immortal.pid

# Runtime logs directory
logs/*.log
.activity-burst
COPILOT_SESSION_STATE.json
COPILOT_SESSION_STATE.md

# Local TermAI service account keys (never commit)
stuff/logs/firebase/*.json
stuff/firebase/*.json
stuff/firebase/firebase

# API vault secrets (keep templates only)
config/api_vault/api-vault.json
config/api_vault/*.local.env

# VS Code extensions (dev workspace)
extensions/
.aider*
backups/restore-points/*.bundle
backups/snapshots/**/*.bundle

