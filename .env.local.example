# ============================================================================
# Molly-Core Environment Variables
#
# EASIEST WAY TO SET UP:
#   In your Codespace terminal, run:
#     npm run setup-keys
#   It asks you to paste two keys. That's it.
#
# OR if you prefer to edit this file directly:
#   cp .env.local.example .env.local
#   Then fill in the values below.
#
# ============================================================================

# REQUIRED — Gemini API Key (Molly cannot think without it)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your-api-key-here

# REQUIRED — Firebase Service Account (Molly cannot remember without it)
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON on one line:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# OPTIONAL — Admin panel credentials
# HIDDEN_ADMIN_USERNAME=your-admin-username
# HIDDEN_ADMIN_PASSWORD=your-admin-password

# OPTIONAL — Firebase Config (already embedded in code, but can override)
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# OPTIONAL — Model overrides (defaults to Gemini 2.5 if not set)
# MOLLY_MODEL_FLASH=googleai/gemini-2.5-flash
# MOLLY_MODEL_PRO=googleai/gemini-2.5-pro
