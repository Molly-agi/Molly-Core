# Google GenAI API Key (required for Molly to function)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your-api-key-here

# Firebase Config (optional - already embedded in code, but can override)
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Admin (server-side, env-only; do not commit JSON key files)
# Option A: full service account JSON as one escaped line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option B: split vars (recommended for local/dev containers)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
