# Hidden admin toolbar credentials
HIDDEN_ADMIN_USERNAME=admin
HIDDEN_ADMIN_PASSWORD=replace-me-set-in-env-local

# Engram memory encryption secret (required for memory persistence)
# Generate with: openssl rand -hex 32
ENGRAM_SECRET=your-engram-secret-here

# Model configuration (defaults: flash=Gemini 3.5, pro=Gemini 3.1 preview)
# Override these to swap models without code changes
# MOLLY_MODEL_FLASH=googleai/gemini-3.5-flash
# MOLLY_MODEL_PRO=googleai/gemini-3.1-pro-preview
# MOLLY_MODEL_TTS=googleai/gemini-2.0-flash-preview
# MOLLY_MODEL_IMAGEN=googleai/imagen-4.0-generate-001
# MOLLY_MODEL_EMBEDDING=googleai/gemini-embedding-2-preview
# MOLLY_MODEL_VIDEO=googleai/veo-3.1-generate-preview
# MOLLY_MODEL_MUSIC=googleai/lyria-3-pro-preview

# Google AI API endpoints (override for custom deployments)
# GOOGLE_GENAI_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_TTS_BASE_URL=https://texttospeech.googleapis.com
# GOOGLE_VEO_BASE_URL=https://videointelligence.googleapis.com
# GOOGLE_LYRIA_BASE_URL=https://music.googleapis.com

# Runtime budget guardrails
MOLLY_DAILY_BUDGET_USD=10
MOLLY_BUDGET_WARNING_THRESHOLD=0.8
MOLLY_MAX_TOKENS_PER_DAY=5000000
MOLLY_RATE_LIMIT_MAX_PER_MINUTE=100000
MOLLY_COST_PER_1M_TOKENS_USD=1.0

# Item 19 — MarkItDown PDF/doc ingestion (watched folder)
# Set ENABLED=1 after running `uv sync` inside markitdown_mcp_server/.
# Files dropped into WATCH_DIR are converted to markdown via the vendored
# Python server, ingested into the KnowledgeStore under userId
# `corpus:markitdown-<slug>-<8hex>`, then moved to <WATCH_DIR>/processed/.
# Failures land in <WATCH_DIR>/failed/ with a sibling `<name>.error.json`.
MOLLY_MARKITDOWN_ENABLED=0
MOLLY_MARKITDOWN_WATCH_DIR=./data/markitdown-inbox
MOLLY_MARKITDOWN_CMD=uv --directory markitdown_mcp_server run markitdown-mcp
MOLLY_MARKITDOWN_TIMEOUT_MS=120000
MOLLY_MARKITDOWN_DEBOUNCE_MS=2000
# Crystal AES-256 key — derived from passphrase via: node scripts/crystal-keygen.mjs
CRYSTAL_KEY=
