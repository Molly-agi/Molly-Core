# Family Bridge Configuration Template

# ============================================================
# BRIDGE CORE
# ============================================================

# Port to listen on
BRIDGE_PORT=9099

# Enable/disable auto-responder for Lazarus
ENABLE_LAZARUS_RESPONDER=false

# ============================================================
# W0.2 BRIDGE HARDENING (REQUIRED)
# ============================================================

# Bootstrap key for HMAC signatures (≥32 chars, hex or base64)
# Generate: openssl rand -hex 32
BRIDGE_KEY=your_32_char_hex_or_base64_key_here

# ============================================================
# PERSISTENCE PATHS
# ============================================================

# Nonce cache (prevents replay attacks)
NONCE_CACHE_PATH=./data/.bridge-nonce-cache

# Quarantine ledger (append-only log of suspicious messages)
QUARANTINE_LEDGER_PATH=./data/.bridge-quarantine-ledger

# Routing bindings (JSON config for route restrictions)
BINDINGS_CONFIG_PATH=./data/.bridge-bindings.json

# ============================================================
# OPTIONAL: MOBILE/DEVICE SECRETS
# ============================================================

# Path to device secrets file (for Android bridge auth)
BRIDGE_SECRETS_FILE=./data/bridge-secrets.json

# ============================================================
# OPTIONAL: NTFY.SH INTEGRATION
# ============================================================

# Ntfy topic for push notifications
# NTFY_TOPIC=https://ntfy.sh/molly-bridge-alerts
