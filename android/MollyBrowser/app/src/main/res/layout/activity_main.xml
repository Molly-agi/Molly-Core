<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f"
    tools:context=".MainActivity">

    <!-- URL Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1e1e2e"
        android:paddingHorizontal="4dp"
        android:gravity="center_vertical">

        <!-- Home button -->
        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="Home"
            android:tint="#e879f9" />

        <!-- GitHub button -->
        <ImageButton
            android:id="@+id/githubButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="GitHub"
            android:tint="#94a3b8" />

        <!-- Status indicator -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textColor="#4ade80"
            android:textSize="9sp"
            android:paddingHorizontal="4dp" />

        <!-- URL input -->
        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/url_input_background"
            android:textColor="#f8fafc"
            android:textColorHint="#64748b"
            android:hint="URL or: github, codespaces, gitpod"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />

        <!-- Refresh button -->
        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Refresh"
            android:tint="#94a3b8" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone"
        android:progressTint="#e879f9"
        android:progressBackgroundTint="#1e1e2e" />

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
